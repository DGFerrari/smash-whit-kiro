# Plantilla de variables de entorno del servidor. Copia este archivo a `.env`
# y rellena los valores reales. NUNCA subas tu `.env` al repo (está en .gitignore).

# Puerto local (el hosting como Render inyecta su propio PORT).
PORT=8787

# --- Base de datos (Neon Postgres) ---
# La connection string que te da Neon (incluye sslmode=require).
DATABASE_URL=postgres://usuario:password@host/db?sslmode=require

# --- Login con Google (OAuth) ---
# Credenciales de "ID de cliente de OAuth" (tipo Aplicación web) de Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secreto para firmar la cookie de sesión. Pon una cadena larga y aleatoria.
SESSION_SECRET=
# Orígenes del cliente permitidos (CORS), separados por comas. El PRIMERO es a
# donde se vuelve tras el login. En local: el dev de Vite. En producción: la URL
# de GitHub Pages CON su subcarpeta. Puedes listar ambos.
# Ej. producción: https://dgferrari.github.io/smash-whit-kiro,http://localhost:5173
CLIENT_URL=http://localhost:5173

# URL pública del propio servidor (para el redirect de OAuth). En local se
# deduce de PORT; en producción es la URL que te da Render.
# Ej: https://smash-b-server.onrender.com
# SERVER_URL=

# En producción el hosting define NODE_ENV=production (activa cookies seguras
# cross-site). En local no hace falta.
# NODE_ENV=production
