# Plantilla de variables de entorno del servidor. Copia este archivo a `.env`
# y rellena los valores reales. NUNCA subas tu `.env` al repo (está en .gitignore).

# Puerto local (el hosting como Render inyecta su propio PORT).
PORT=8787

# --- Base de datos (Neon Postgres) ---
# La connection string que te da Neon (incluye sslmode=require).
DATABASE_URL=postgres://usuario:password@host/db?sslmode=require

# --- Login con Google (OAuth) ---
# Credenciales de "ID de cliente de OAuth" (tipo Aplicación web) de Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secreto para firmar la cookie de sesión. Pon una cadena larga y aleatoria.
SESSION_SECRET=
# URL del cliente (a donde se vuelve tras el login). En local, el dev de Vite.
CLIENT_URL=http://localhost:5173
